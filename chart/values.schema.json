{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "OpenCode Helm Chart Values",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of OpenCode server replicas."
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"],
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" }
      },
      "additionalProperties": false
    },
    "securityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["string", "number", "boolean", "null"] },
          "valueFrom": { "type": "object" }
        },
        "required": ["name"]
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "content": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "basic": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "username": { "type": "string" },
            "existingSecret": { "type": "string" },
            "passwordKey": { "type": "string" },
            "password": { "type": "string" }
          },
          "additionalProperties": false
        },
        "existingSecret": { "type": "string" },
        "apiKeySecret": {
          "type": "object",
          "description": "Map of env var name to value, stored in a Secret and injected as env.",
          "additionalProperties": { "type": "string" }
        },
        "secretAnnotations": { "type": "object" }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"] },
        "loadBalancerIP": { "type": ["string", "null"] },
        "annotations": { "type": "object" },
        "labels": { "type": "object" }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" },
        "certManagerIssuer": { "type": "string" }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string" },
        "mountPath": { "type": "string" },
        "annotations": { "type": "object" }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "dnsNamespace": { "type": "string" },
        "egress": { "type": "array" }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": ["object", "null"],
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "hpa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "metrics": { "type": "array" }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      },
      "additionalProperties": false
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  }
}
